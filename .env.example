NODE_ENV=development
PORT=5000

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/migo?schema=public"

# Auth
BCRYPT_SALT_ROUNDS=10
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SSLCommerz (sandbox first)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/payment/success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/payment/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/payment/cancel
SSLCOMMERZ_IPN_URL=http://localhost:5000/api/v1/payments/ipn

# Redis (optional — in-memory fallback is used if unset)
REDIS_URL=

# Frontend / CORS
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

SWAGGER_BASE_URL=http://localhost:5000

# In development, OTP/email tokens are returned in API responses for Postman testing
DEV_RETURN_OTP=true
